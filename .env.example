# Copy to .env and fill in. All keys are server-side only; never expose them to the browser.

# Postgres connection string. docker compose creates two databases:
# investhub_dev for development (also the default when this is empty) and
# investhub for your real portfolio; switch the last path segment to /investhub
# for real use. Required when NODE_ENV=production: the app, worker and
# migrations refuse to start without it.
DATABASE_URL=postgres://investhub:investhub@127.0.0.1:55432/investhub_dev

# brapi.dev free token: required for FIIs, ETFs and BDRs
BRAPI_TOKEN=

# Finnhub free key: US real-time quotes and company news (personal use only)
FINNHUB_API_KEY=

# CoinGecko demo key: crypto prices (attribution required in the UI)
COINGECKO_DEMO_API_KEY=

# LLM provider: gemini | ollama (others may be added behind the same interface)
LLM_PROVIDER=gemini
# Google Gemini free-tier key (free-tier prompts may be used by Google; no amounts are ever sent)
GEMINI_API_KEY=
# Local Ollama endpoint, used when LLM_PROVIDER=ollama
OLLAMA_BASE_URL=

# Telegram bot for alerts and digest delivery
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# true = public demo: seeded fake data, all writes blocked, no live feeds
DEMO_MODE=false
